datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Collection {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId          String
  name              String
  schema            Json? // Optional JSON schema for validation
  validationEnabled Boolean  @default(false)
  permissions       Json? // Collection permissions definition
  indexes           Json? // Indexes configuration
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Record {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId   String
  collection String
  ownerId    String // User ID from JWT
  data       Json // Generic payload
  deletedAt  DateTime? // Soft delete timestamp
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId, collection, deletedAt])
  @@index([tenantId, collection, ownerId, deletedAt])
}

model AuditLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String
  userId       String
  action       String
  collectionId String?
  recordId     String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
}
